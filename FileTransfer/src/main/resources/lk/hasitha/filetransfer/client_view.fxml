<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.hasitha.filetransfer.ClientController">
   <center>
      <VBox spacing="10.0" BorderPane.alignment="CENTER">
         <children>
            <TextArea fx:id="txtArea" editable="false" wrapText="true" VBox.vgrow="ALWAYS" />
            <HBox alignment="CENTER_RIGHT" spacing="5.0">
               <children>
                  <Label fx:id="lblSelectedFile" text="file not selected" HBox.hgrow="ALWAYS" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="btnChooseFile" mnemonicParsing="false" onAction="#handleSelectFile" text="Choose FIle" HBox.hgrow="ALWAYS" />
                  <Button fx:id="btnFile" mnemonicParsing="false" onAction="#handleSendFile" text="SEND" />
                  <Button fx:id="btnClear" layoutX="512.0" layoutY="10.0" mnemonicParsing="false" onAction="#handleClear" text="Clear" />
               </children>
            </HBox>
         </children>
         <BorderPane.margin>
            <Insets />
         </BorderPane.margin>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </VBox>
   </center>
</BorderPane>
