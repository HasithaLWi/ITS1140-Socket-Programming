<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="lk.hasitha.server.ServerController">
   <bottom>
      <HBox alignment="CENTER" spacing="10.0" BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="btnEmoji" mnemonicParsing="false" onAction="#handleSendEmoji" style="-fx-background-color: transparent; -fx-label-padding: 0;">
               <font>
                  <Font size="1.0" />
               </font>
               <graphic>
                  <Label text="🙂">
                     <font>
                        <Font size="22.0" />
                     </font>
                  </Label>
               </graphic></Button>
            <TextField fx:id="txtField" maxWidth="1.7976931348623157E308" onAction="#handleSendMassage" HBox.hgrow="ALWAYS" />
            <Button fx:id="btnFile" layoutX="554.0" layoutY="20.0" mnemonicParsing="false" onAction="#handleSendMassage" text="SEND" />
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </HBox>
   </bottom>
   <center>
      <VBox spacing="10.0" BorderPane.alignment="CENTER">
         <children>
            <TextArea fx:id="txtArea" wrapText="true" VBox.vgrow="ALWAYS" />
            <HBox alignment="CENTER_RIGHT">
               <children>
                  <Label fx:id="lblSelectedFile" text="no file selected" HBox.hgrow="ALWAYS" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="btnChooseFile" mnemonicParsing="false" onAction="#handleSendFile" text="Choose FIle" HBox.hgrow="ALWAYS" />
                  <Button fx:id="btnClear" layoutX="512.0" layoutY="10.0" mnemonicParsing="false" onAction="#handleClear" text="Clear" />
               </children>
            </HBox>
         </children>
         <BorderPane.margin>
            <Insets />
         </BorderPane.margin>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </VBox>
   </center>
</BorderPane>
